generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  sessions       Session[]
  checklistItems ChecklistItem[]
  timeblocks     Timeblock[]
  tags           Tag[]
  tagInstances   TagInstance[]
  commands       Command[]
  posts          Post[]
  prompts        Prompt[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("sessions")
}

model ChecklistItem {
  id             Int      @id @default(autoincrement())
  title          String
  completed      Boolean  @default(false)
  sortOrder      Int      @default(0) @map("sort_order")
  orientingBlock Boolean  @default(false) @map("orienting_block")
  section        String?
  userId         Int?     @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("checklist_items")
}

model Timeblock {
  id             Int      @id @default(autoincrement())
  rayNotes       String?  @map("ray_notes")
  assistantNotes String?  @map("assistant_notes")
  aiNotes        String?  @map("ai_notes")
  datetime       DateTime @db.Timestamptz
  duration       Int      @default(15)
  userId         Int?     @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("timeblocks")
}

model Tag {
  id            Int           @id @default(autoincrement())
  name          String
  type          String
  subtype       String?
  description   String?
  parentTagId   Int?          @map("parent_tag_id")
  parentTag     Tag?          @relation("TagParent", fields: [parentTagId], references: [id], onDelete: SetNull)
  childTags     Tag[]         @relation("TagParent")
  suggestedTagIds Json?         @map("suggested_tag_ids")
  noAiSuggest   Boolean       @default(false) @map("no_ai_suggest")
  userId        Int?          @map("user_id")
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances     TagInstance[]
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@unique([name, type])
  @@map("tags")
}

model TagInstance {
  id           Int      @id @default(autoincrement())
  tagId        Int      @map("tag_id")
  tag          Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  datetime     DateTime @db.Timestamptz
  llmPredicted Boolean  @default(false) @map("llm_predicted")
  approved     Boolean  @default(true)
  llmReason    String?  @map("llm_reason")
  useful       Boolean  @default(false)
  antiUseful   Boolean  @default(false) @map("anti_useful")
  userId       Int?     @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, datetime])
  @@map("tag_instances")
}

model Command {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  html      String
  order     Int      @default(0)
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("commands")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("posts")
}

model Prompt {
  id        Int      @id @default(autoincrement())
  title     String
  text      String
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("prompts")
}

model Story {
  id           Int          @id @default(autoincrement())
  source       String
  externalId   String       @map("external_id")
  title        String
  url          String
  domain       String
  // Used only by sources without structured points/comments (arxiv: "Author · Date").
  // HN/LW leave this null and render from points/commentCount.
  byline       String?
  points       Int?
  commentCount Int?         @map("comment_count")
  snippet      String
  snippetHtml  String?      @map("snippet_html")
  iframe       Boolean?
  rank         Int          @default(0)
  postedAt     DateTime?    @map("posted_at") @db.Timestamptz
  fetchedAt    DateTime     @map("fetched_at") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  forYouItems  ForYouItem[]

  @@unique([source, url])
  @@index([source, createdAt])
  @@map("stories")
}

model ForYouItem {
  id        Int      @id @default(autoincrement())
  storyId   Int      @map("story_id")
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reason    String
  relevance Int      @default(0)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("for_you_items")
}
