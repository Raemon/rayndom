generator client {
  provider = "prisma-client"
  output   = "../lib/generated/observatoryPrisma"
}

datasource db {
  provider = "postgresql"
}

model ObservatoryUser {
  id                     Int                          @id @default(autoincrement())
  email                  String                       @unique
  passwordHash           String                       @map("password_hash")
  emailVerifiedAt        DateTime?                    @map("email_verified_at") @db.Timestamptz
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  sessions               ObservatorySession[]
  loginAttempts          ObservatoryLoginAttempt[]
  passwordResetTokens    ObservatoryPasswordResetToken[]
  emailVerificationTokens ObservatoryEmailVerificationToken[]
  sourceDomains          ObservatorySourceDomain[]
  seedUrls               ObservatorySeedUrl[]
  ingestJobs             ObservatoryIngestJob[]
  profiles               ObservatoryUserProfile[]
  profileRevisions       ObservatoryProfileRevision[]
  tuningPrompt           ObservatoryTuningPrompt?
  recommendationBatches  ObservatoryRecommendationBatch[]
  feedbackEvents         ObservatoryFeedbackEvent[]
  savedItems             ObservatorySavedItem[]
  dismissedItems         ObservatoryDismissedItem[]

  @@map("observatory_users")
}

model ObservatorySession {
  id         String           @id @default(uuid())
  userId     Int              @map("user_id")
  user       ObservatoryUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz
  lastSeenAt DateTime         @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("observatory_sessions")
}

model ObservatoryLoginAttempt {
  id         Int               @id @default(autoincrement())
  userId     Int?              @map("user_id")
  user       ObservatoryUser?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  ipHash     String?           @map("ip_hash")
  successful Boolean           @default(false)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@map("observatory_login_attempts")
}

model ObservatoryPasswordResetToken {
  id         Int               @id @default(autoincrement())
  userId     Int               @map("user_id")
  user       ObservatoryUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String            @unique @map("token_hash")
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz
  usedAt     DateTime?         @map("used_at") @db.Timestamptz
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, expiresAt])
  @@map("observatory_password_reset_tokens")
}

model ObservatoryEmailVerificationToken {
  id         Int               @id @default(autoincrement())
  userId     Int               @map("user_id")
  user       ObservatoryUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String            @unique @map("token_hash")
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz
  usedAt     DateTime?         @map("used_at") @db.Timestamptz
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, expiresAt])
  @@map("observatory_email_verification_tokens")
}

model ObservatorySourceDomain {
  id         Int                     @id @default(autoincrement())
  userId     Int                     @map("user_id")
  user       ObservatoryUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain     String
  status     String                  @default("pending")
  notes      String?
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  seedUrls   ObservatorySeedUrl[]
  fetchedPages ObservatoryFetchedPage[]

  @@unique([userId, domain])
  @@index([status])
  @@map("observatory_source_domains")
}

model ObservatorySeedUrl {
  id             Int                     @id @default(autoincrement())
  userId         Int                     @map("user_id")
  user           ObservatoryUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDomainId Int?                    @map("source_domain_id")
  sourceDomain   ObservatorySourceDomain? @relation(fields: [sourceDomainId], references: [id], onDelete: SetNull)
  url            String
  title          String?
  status         String                  @default("pending")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  ingestJobs     ObservatoryIngestJob[]

  @@unique([userId, url])
  @@index([status])
  @@map("observatory_seed_urls")
}

model ObservatoryIngestJob {
  id             Int                     @id @default(autoincrement())
  userId         Int                     @map("user_id")
  user           ObservatoryUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  seedUrlId      Int?                    @map("seed_url_id")
  seedUrl        ObservatorySeedUrl?     @relation(fields: [seedUrlId], references: [id], onDelete: SetNull)
  jobType        String                  @map("job_type")
  status         String                  @default("queued")
  targetUrl      String?                 @map("target_url")
  error          String?
  metadataJson   Json?                   @map("metadata_json")
  startedAt      DateTime?               @map("started_at") @db.Timestamptz
  completedAt    DateTime?               @map("completed_at") @db.Timestamptz
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, status, createdAt])
  @@map("observatory_ingest_jobs")
}

model ObservatoryFetchedPage {
  id             Int                     @id @default(autoincrement())
  sourceDomainId Int?                    @map("source_domain_id")
  sourceDomain   ObservatorySourceDomain? @relation(fields: [sourceDomainId], references: [id], onDelete: SetNull)
  url            String                  @unique
  finalUrl       String?                 @map("final_url")
  domain         String
  title          String?
  statusCode     Int?                    @map("status_code")
  contentType    String?                 @map("content_type")
  rawHtml        String?                 @map("raw_html")
  fetchError     String?                 @map("fetch_error")
  fetchedAt      DateTime                @default(now()) @map("fetched_at") @db.Timestamptz
  document       ObservatoryExtractedDocument?

  @@index([sourceDomainId, fetchedAt])
  @@map("observatory_fetched_pages")
}

model ObservatoryExtractedDocument {
  id               Int                       @id @default(autoincrement())
  fetchedPageId    Int?                      @unique @map("fetched_page_id")
  fetchedPage      ObservatoryFetchedPage?   @relation(fields: [fetchedPageId], references: [id], onDelete: SetNull)
  sourceType       String                    @map("source_type")
  sourceLabel      String                    @map("source_label")
  externalId       String?                   @map("external_id")
  title            String
  url              String                    @unique
  canonicalUrl     String?                   @map("canonical_url")
  domain           String
  byline           String?
  excerpt          String
  excerptHtml      String?                   @map("excerpt_html")
  bodyText         String?                   @map("body_text")
  bodyHtml         String?                   @map("body_html")
  publishedAt      DateTime?                 @map("published_at") @db.Timestamptz
  importedAt       DateTime                  @default(now()) @map("imported_at") @db.Timestamptz
  documentLinks    ObservatoryDocumentLink[]
  recommendationItems ObservatoryRecommendationItem[]
  feedbackEvents   ObservatoryFeedbackEvent[]
  savedItems       ObservatorySavedItem[]
  dismissedItems   ObservatoryDismissedItem[]

  @@index([sourceType, importedAt])
  @@index([domain])
  @@map("observatory_extracted_documents")
}

model ObservatoryDocumentLink {
  id          Int                        @id @default(autoincrement())
  documentId  Int                        @map("document_id")
  document    ObservatoryExtractedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  targetUrl   String                     @map("target_url")
  anchorText  String?                    @map("anchor_text")
  sameDomain  Boolean                    @default(false) @map("same_domain")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  @@index([documentId])
  @@map("observatory_document_links")
}

model ObservatoryUserProfile {
  id               Int                      @id @default(autoincrement())
  userId           Int                      @map("user_id")
  user             ObservatoryUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary          String
  keywordsJson     Json?                    @map("keywords_json")
  sourceCount      Int                      @default(0) @map("source_count")
  documentCount    Int                      @default(0) @map("document_count")
  lastGeneratedAt  DateTime?                @map("last_generated_at") @db.Timestamptz
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  profileRevisions ObservatoryProfileRevision[]

  @@index([userId, updatedAt])
  @@map("observatory_user_profiles")
}

model ObservatoryProfileRevision {
  id             Int                     @id @default(autoincrement())
  userId         Int                     @map("user_id")
  user           ObservatoryUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProfileId  Int?                    @map("user_profile_id")
  userProfile    ObservatoryUserProfile? @relation(fields: [userProfileId], references: [id], onDelete: SetNull)
  summary        String
  promptSnapshot String?                 @map("prompt_snapshot")
  keywordsJson   Json?                   @map("keywords_json")
  sourceCount    Int                     @default(0) @map("source_count")
  documentCount  Int                     @default(0) @map("document_count")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt])
  @@map("observatory_profile_revisions")
}

model ObservatoryTuningPrompt {
  id         Int               @id @default(autoincrement())
  userId     Int               @unique @map("user_id")
  user       ObservatoryUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt     String
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("observatory_tuning_prompts")
}

model ObservatoryRecommendationBatch {
  id             Int                          @id @default(autoincrement())
  userId         Int                          @map("user_id")
  user           ObservatoryUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tabKey         String                       @map("tab_key")
  status         String                       @default("ready")
  generationNote String?                      @map("generation_note")
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  completedAt    DateTime?                    @map("completed_at") @db.Timestamptz
  items          ObservatoryRecommendationItem[]

  @@index([userId, tabKey, createdAt])
  @@map("observatory_recommendation_batches")
}

model ObservatoryRecommendationItem {
  id             Int                            @id @default(autoincrement())
  batchId        Int                            @map("batch_id")
  batch          ObservatoryRecommendationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  documentId     Int?                           @map("document_id")
  document       ObservatoryExtractedDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title          String
  url            String
  domain         String
  byline         String?
  snippet        String
  snippetHtml    String?                        @map("snippet_html")
  reason         String?
  iframe         Boolean                        @default(true)
  score          Float                          @default(0)
  rank           Int                            @default(0)
  createdAt      DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  feedbackEvents ObservatoryFeedbackEvent[]
  savedItems     ObservatorySavedItem[]

  @@index([batchId, rank])
  @@map("observatory_recommendation_items")
}

model ObservatoryFeedbackEvent {
  id                   Int                            @id @default(autoincrement())
  userId               Int                            @map("user_id")
  user                 ObservatoryUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationItemId Int?                           @map("recommendation_item_id")
  recommendationItem   ObservatoryRecommendationItem? @relation(fields: [recommendationItemId], references: [id], onDelete: SetNull)
  documentId           Int?                           @map("document_id")
  document             ObservatoryExtractedDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  eventType            String                         @map("event_type")
  note                 String?
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, eventType, createdAt])
  @@index([documentId, createdAt])
  @@map("observatory_feedback_events")
}

model ObservatorySavedItem {
  id                   Int                            @id @default(autoincrement())
  userId               Int                            @map("user_id")
  user                 ObservatoryUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationItemId Int?                           @unique @map("recommendation_item_id")
  recommendationItem   ObservatoryRecommendationItem? @relation(fields: [recommendationItemId], references: [id], onDelete: SetNull)
  documentId           Int?                           @map("document_id")
  document             ObservatoryExtractedDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  url                  String
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt])
  @@map("observatory_saved_items")
}

model ObservatoryDismissedItem {
  id         Int                           @id @default(autoincrement())
  userId     Int                           @map("user_id")
  user       ObservatoryUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId Int?                          @map("document_id")
  document   ObservatoryExtractedDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  url        String
  createdAt  DateTime                      @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, url])
  @@index([userId, createdAt])
  @@map("observatory_dismissed_items")
}
